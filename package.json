{
  "name": "mac-routine-tracker",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'dist-electron', 'release'].forEach(dir => fs.rmSync(dir, { recursive: true, force: true }));\"",
    "build": "npm run clean && tsc -p tsconfig.electron.json && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:start": "electron .",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"electron .\"",
    "build:icons": "electron-icon-builder --input=./icon.png --output=./build --flatten"
  },
  "build": {
    "appId": "com.routine.tracker",
    "productName": "Daily Routine Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/icons/icon.icns",
      "minimumSystemVersion": "10.13"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icons/icon.ico"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^8.7.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^1.11.0",
    "react": "^18.3.1",
    "react-activity-calendar": "^3.2.0",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^16.18.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^25.8.4",
    "electron-builder": "^24.6.4",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^4.5.3",
    "vitest": "^0.34.6"
  }
}
